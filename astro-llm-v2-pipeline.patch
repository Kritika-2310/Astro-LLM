index 0000000..5a502f8
--- /dev/null
+++ b/scripts/data_pipeline/01_extract_corpus.py
@@ -0,0 +1,126 @@
+"""
+Step 1: Build the source corpus (OpenStax Astronomy 2e + Wikipedia) and hold out whole chapters.
+
+Usage:
+    python scripts/data_pipeline/01_extract_corpus.py --pdf data/raw/astronomy2e.pdf --list-only   # inspect chapters
+    python scripts/data_pipeline/01_extract_corpus.py --pdf data/raw/astronomy2e.pdf \
+        --wiki-tsv data/raw/wiki_topics.tsv
+
+wiki_topics.tsv: one line per page -> <Wikipedia page title><TAB><OpenStax chapter number>
+    The chapter number decides whether the page is held out (pages of held-out chapters never reach training).
+
+Outputs (data/corpus/):
+    chunks_train.jsonl, chunks_heldout.jsonl, heldout_chapters.json
+"""
+import argparse
+import random
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import ROOT, load_cfg, write_jsonl  # noqa: E402
+
+import json  # noqa: E402
+
+
+def clean(text):
+    lines = []
+    for ln in text.splitlines():
+        s = ln.strip()
+        if not s or "openstax.org" in s.lower():
+            continue
+        if re.fullmatch(r"\d{1,4}", s):          # bare page numbers
+            continue
+        lines.append(s)
+    out = " ".join(lines)
+    return re.sub(r"\s+", " ", out)
+
+
+def chunk_words(text, size, overlap):
+    words = text.split()
+    step = max(size - overlap, 1)
+    return [" ".join(words[i:i + size]) for i in range(0, len(words), step)]
+
+
+def openstax_chapters(pdf_path, regex):
+    import fitz
+    doc = fitz.open(pdf_path)
+    toc = [t for t in doc.get_toc() if t[0] == 1]
+    if not toc:
+        sys.exit("No level-1 bookmarks in the PDF. Use the web-PDF from openstax.org or adapt this function.")
+    chapters = [(title.strip(), start) for _, title, start in toc if re.match(regex, title.strip())]
+    result = []
+    for i, (title, start) in enumerate(chapters):
+        nxt = chapters[i + 1][1] if i + 1 < len(chapters) else None
+        end = (nxt - 1) if nxt else len(doc)
+        text = clean(" ".join(doc[p].get_text() for p in range(start - 1, end)))
+        result.append((i + 1, title, text))
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--pdf", required=True)
+    ap.add_argument("--wiki-tsv", default=None)
+    ap.add_argument("--list-only", action="store_true")
+    ap.add_argument("--cfg", default=None)
+    args = ap.parse_args()
+
+    cfg = load_cfg(args.cfg)
+    c = cfg["corpus"]
+    chapters = openstax_chapters(args.pdf, c["openstax_chapter_regex"])
+    print(f"Found {len(chapters)} chapters:")
+    for n, title, text in chapters:
+        print(f"  {n:>2}  {title[:70]:<70} {len(text.split()):>7} words")
+    if args.list_only:
+        print("\nIf this list looks wrong (front matter, appendices), tune corpus.openstax_chapter_regex in configs/data_pipeline.yaml.")
+        return
+
+    rng = random.Random(cfg["seed"])
+    heldout_ids = sorted(rng.sample([n for n, _, _ in chapters], c["n_heldout_chapters"]))
+    title_of = {n: t for n, t, _ in chapters}
+
+    records = []
+    for n, title, text in chapters:
+        for j, ch in enumerate(chunk_words(text, c["chunk_words"], c["chunk_overlap"])):
+            if len(ch.split()) < c["min_chunk_words"]:
+                continue
+            records.append({"chunk_id": f"openstax-{n:02d}-{j:04d}", "source": "openstax_astronomy_2e",
+                            "chapter_idx": n, "chapter": title, "text": ch})
+
+    if args.wiki_tsv:
+        import wikipediaapi
+        wiki = wikipediaapi.Wikipedia(
+            user_agent="AstroSagan-research/0.1 (https://github.com/Kritika-2310/Astro-LLM)", language="en")
+        for ln in Path(args.wiki_tsv).read_text().splitlines():
+            if not ln.strip() or ln.startswith("#"):
+                continue
+            page_title, ch_no = [x.strip() for x in ln.split("\t")]
+            ch_no = int(ch_no)
+            page = wiki.page(page_title)
+            if not page.exists():
+                print(f"  wiki: missing page {page_title!r}")
+                continue
+            text = re.sub(r"\s+", " ", page.text)
+            for j, ch in enumerate(chunk_words(text, c["chunk_words"], c["chunk_overlap"])):
+                if len(ch.split()) < c["min_chunk_words"]:
+                    continue
+                slug = re.sub(r"\W+", "-", page_title.lower()).strip("-")
+                records.append({"chunk_id": f"wiki-{slug}-{j:03d}", "source": "wikipedia",
+                                "chapter_idx": ch_no, "chapter": title_of.get(ch_no, f"chapter {ch_no}"),
+                                "wiki_title": page_title, "text": ch})
+
+    train = [r for r in records if r["chapter_idx"] not in heldout_ids]
+    held = [r for r in records if r["chapter_idx"] in heldout_ids]
+    out = ROOT / "data" / "corpus"
+    write_jsonl(out / "chunks_train.jsonl", train)
+    write_jsonl(out / "chunks_heldout.jsonl", held)
+    (out / "heldout_chapters.json").write_text(json.dumps(
+        {"seed": cfg["seed"], "heldout": [{"idx": n, "title": title_of[n]} for n in heldout_ids]}, indent=2))
+    print(f"\nHeld-out chapters: {[(n, title_of[n]) for n in heldout_ids]}")
+    print(f"chunks_train: {len(train)}   chunks_heldout: {len(held)}   -> {out}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/data_pipeline/02_generate_qa.py b/scripts/data_pipeline/02_generate_qa.py
new file mode 100644
index 0000000..30ea810
--- /dev/null
+++ b/scripts/data_pipeline/02_generate_qa.py
@@ -0,0 +1,118 @@
+"""
+Step 2: For sampled training chunks, have Gemini write ONE question and answer it in all audience styles.
+One call per chunk; resume-safe (re-run any time, e.g. after the daily free-tier quota resets).
+
+Usage:
+    python scripts/data_pipeline/02_generate_qa.py --limit 200      # do up to 200 new chunks this session
+"""
+import argparse
+import random
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from common import (ROOT, QuotaExhausted, append_jsonl, ask_json, gemini_client,  # noqa: E402
+                    load_cfg, load_styles, read_jsonl, shared_rules)
+
+QTYPES = [
+    "a 'why' question about a cause or reason",
+    "a 'how does it work' question about a mechanism",
+    "a question about scale, size, distance or time",
+    "a question comparing two things or two cases",
+    "a 'what is' question for a key concept",
+    "a question that corrects a common misconception",
+]
+SKIP_MARKERS = ("Thought Questions", "Figuring For Yourself", "Review Questions", "Collaborative Group Activities")
+
+PROMPT = """<<RULES>>
+
+You are writing training data for an astronomy tutor. Below is a passage from <<SOURCE>>.
+
+PASSAGE:
+<<CHUNK>>
+
+Task:
+1. Write ONE self-contained question a learner might ask whose answer is supported by the passage. Make it <<QTYPE>>. It must make sense without the passage: never say "the passage", "the text", "this chapter", or "the author".
+2. Answer it three times, each pitched at a different audience:
+<<STYLES>>
+
+Every factual claim and number must be supported by the passage (do not add outside facts). Do not mention the passage or the audience. Keep the same warm voice in all three answers; only the depth and vocabulary change.
+
+Return ONLY JSON: {"question": "...", "answers": {<<KEYS>>}}"""
+
+
+def pick_chunks(chunks, n, seed):
+    rng = random.Random(seed)
+    good = [c for c in chunks if not any(m.lower() in c["text"].lower() for m in SKIP_MARKERS)]
+    by_ch = {}
+    for c in good:
+        by_ch.setdefault(c["chapter_idx"], []).append(c)
+    for v in by_ch.values():
+        rng.shuffle(v)
+    order, keys = [], sorted(by_ch)
+    while len(order) < n and any(by_ch.values()):
+        for k in keys:
+            if by_ch[k]:
+                order.append(by_ch[k].pop())
+                if len(order) >= n:
+                    break
+    return order
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--limit", type=int, default=None, help="max NEW chunks this run")
+    ap.add_argument("--cfg", default=None)
+    args = ap.parse_args()
+
+    cfg = load_cfg(args.cfg)
+    g = cfg["generation"]
+    styles = load_styles()
+    chunks = read_jsonl(ROOT / "data/corpus/chunks_train.jsonl")
+    if not chunks:
+        sys.exit("Run 01_extract_corpus.py first.")
+    plan = pick_chunks(chunks, g["target_questions"], cfg["seed"])
+
+    out = ROOT / "data/interim/raw_qa.jsonl"
+    done = {r["chunk_id"] for r in read_jsonl(out)}
+    todo = [(i, c) for i, c in enumerate(plan) if c["chunk_id"] not in done]
+    if args.limit:
+        todo = todo[: args.limit]
+    print(f"{len(done)} done, {len(todo)} to do this run (target {len(plan)})")
+
+    style_block = "\n".join(f'   - "{k}" = {v["name"]}: {v["description"]} ({v["words"][0]}-{v["words"][1]} words)'
+                            for k, v in styles.items())
+    keys = ", ".join(f'"{k}": "..."' for k in styles)
+    client = gemini_client()
+    rules = shared_rules()
+
+    for n, (i, c) in enumerate(todo, 1):
+        prompt = (PROMPT.replace("<<RULES>>", rules)
+                  .replace("<<SOURCE>>", "OpenStax Astronomy 2e" if c["source"].startswith("openstax") else "Wikipedia")
+                  .replace("<<CHUNK>>", c["text"])
+                  .replace("<<QTYPE>>", QTYPES[i % len(QTYPES)])
+                  .replace("<<STYLES>>", style_block)
+                  .replace("<<KEYS>>", keys))
+        try:
+            res = ask_json(client, g["gen_model"], prompt, temperature=g["temperature"])
+        except QuotaExhausted as e:
+            print(f"\nQuota/rate limit hit after {n-1} chunks this run. Re-run later; progress is saved.\n{str(e)[:200]}")
+            return
+        ok = (isinstance(res, dict) and isinstance(res.get("question"), str)
+              and isinstance(res.get("answers"), dict) and all(k in res["answers"] for k in styles))
+        if not ok:
+            print(f"[{n}/{len(todo)}] {c['chunk_id']}: bad output, skipped")
+            continue
+        append_jsonl(out, {
+            "qid": f"q-{c['chunk_id']}", "question": res["question"].strip(), "answers": res["answers"],
+            "chunk_id": c["chunk_id"], "chapter": c["chapter"], "chapter_idx": c["chapter_idx"],
+            "source": c["source"], "chunk_text": c["text"], "gen_model": g["gen_model"],
+        })
+        print(f"[{n}/{len(todo)}] {c['chunk_id']}: {res['question'][:70]}")
+        time.sleep(g["sleep_seconds"])
+    print("Done with this batch.")
+
+
+if __name__ == "__main__":
+    main()

+corpus:
+  chunk_words: 350            # words per chunk
+  chunk_overlap: 50
+  min_chunk_words: 200        # shorter chunks are dropped
+  n_heldout_chapters: 3       # whole chapters (and their Wikipedia pages) never used for training data
